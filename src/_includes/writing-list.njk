<ul class="entries">
  {%- for post in posts %}
  <li class="entry">
    <span class="entry__no"><span class="visually-hidden">Number </span>{{ post.data.order | pad }}</span>
    <div class="entry__body">
      <h3 class="entry__title"><a href="{{ post.url }}">{{ post.data.title }}</a></h3>
      <p>{{ post.data.description }}</p>
    </div>
    <span class="entry__meta">{{ post.templateContent | readingMinutes }} min</span>
  </li>
  {%- endfor %}
</ul>
