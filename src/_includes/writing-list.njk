<ul class="entries">
  {%- for post in posts %}
  <li class="entry">
    <p class="entry__meta">No. {{ post.data.order | pad }} · {{ post.templateContent | readingMinutes }} min read</p>
    <h2 class="entry__title"><a href="{{ post.url }}">{{ post.data.title }}</a></h2>
    <p>{{ post.data.description }}</p>
  </li>
  {%- endfor %}
</ul>
